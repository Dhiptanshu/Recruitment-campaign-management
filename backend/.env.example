# Leave DATABASE_URL unset for local dev - defaults to a SQLite file at backend/globalvox.db
# In production (Render), this is set automatically by the Postgres add-on defined in render.yaml
# DATABASE_URL=postgresql://user:password@host:5432/globalvox

# Comma-separated list of origins allowed to call this API.
# Defaults to the local Vite dev server if unset.
# In production, set this to your deployed frontend URL(s), e.g.:
# ALLOWED_ORIGINS=https://your-app.vercel.app,https://your-custom-domain.com
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- LLM (optional) ---
# If LLM_API_KEY is unset, candidate scoring/summaries silently use the
# deterministic heuristic scorer instead -- the app works fully either way.
# LLM_API_BASE_URL=https://aicredits.in/v1
# LLM_API_KEY=your-key-here
# LLM_MODEL=gpt-4o-mini
# LLM_TIMEOUT_SECONDS=15
